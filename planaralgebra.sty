        \str_if_eq:eeF { \__planar_type:n {##1} } { id }
          {
            \bool_set_true:N \l__planar_has_one_bool
            \tl_set_eq:NN \l__planar_prefix_tl \l__planar_tmp_tl
            \int_set_eq:NN \l__planar_pa_int \l__planar_i_int
            \bool_set:Nn \l__planar_zero_one_bool
              { \int_compare_p:nNn { \__planar_out:n {##1} } = 0 }
          }
      }
    \int_zero:N \l__planar_pb_int
    \bool_set_false:N \l__planar_has_two_bool
    \tl_map_inline:nn {#2}
      {
        \bool_if:NF \l__planar_has_two_bool
          {
            \str_if_eq:eeTF { \__planar_type:n {##1} } { id }
              { \int_incr:N \l__planar_pb_int }
              {
                \bool_set_true:N \l__planar_has_two_bool
                \bool_set:Nn \l__planar_zero_two_bool
                  { \int_compare_p:nNn { \__planar_in:n {##1} } = 0 }
              }
          }
      }
    \bool_set_false:N \l__planar_merge_bool
    \bool_lazy_and:nnT { \l__planar_has_one_bool } { \l__planar_has_two_bool }
      {
        \bool_if:nTF { \l__planar_zero_one_bool && \l__planar_zero_two_bool }
          {
            \int_compare:nNnT \l__planar_pb_int > \l__planar_pa_int
              { \bool_set_true:N \l__planar_merge_bool }
          }
          {
            \int_compare:nNnF \l__planar_pb_int < \l__planar_pa_int
              { \bool_set_true:N \l__planar_merge_bool }
          }
      }
    \bool_if:NT \l__planar_merge_bool
      {
        \tl_set_eq:NN \l__planar_merged_tl \l__planar_prefix_tl
        \int_zero:N \l__planar_i_int
        \tl_map_inline:nn {#2}
          {
            \int_incr:N \l__planar_i_int
            \int_compare:nNnT \l__planar_i_int > \l__planar_pa_int
              { \tl_put_right:Nn \l__planar_merged_tl { {##1} } }
          }
      }
  }
\cs_generate_variant:Nn \__planar_try_merge:nn { Vn }

% The reduced form as a string of \PA commands.
\cs_new_protected:Npn \__planar_nf_string:
  {
    \str_clear:N \l__planar_nf_str
    \seq_map_inline:Nn \l__planar_nf_seq
      {
        \str_put_right:Ne \l__planar_nf_str
          {
            \c_backslash_str PA \c_left_brace_str
            \__planar_layer_in:n {##1} , \__planar_layer_out:n {##1}
            \c_right_brace_str \c_left_brace_str
          }
        \tl_clear:N \l__planar_last_tl
        \int_zero:N \l__planar_k_int
        \bool_set_true:N \l__planar_first_bool
        \tl_map_inline:nn {##1} { \__planar_nf_item:nnnn ####1 }
        \__planar_nf_flush:
        \str_put_right:Ne \l__planar_nf_str { \c_right_brace_str }
      }
    \str_gset_eq:NN \g__planar_nf_str \l__planar_nf_str
  }
\cs_new_protected:Npn \__planar_nf_item:nnnn #1#2#3#4
  {
    \str_if_eq:nnTF {#1} { box }
      {
        \__planar_nf_flush:
        \__planar_nf_sep:
        \str_put_right:Ne \l__planar_nf_str { \tl_to_str:n {#4} (#2,#3) }
      }
      {
        \str_if_eq:VnF \l__planar_last_tl {#1} { \__planar_nf_flush: }
        \tl_set:Nn \l__planar_last_tl {#1}
        \int_incr:N \l__planar_k_int
      }
  }
\cs_new_protected:Npn \__planar_nf_sep:
  {
    \bool_if:NF \l__planar_first_bool { \str_put_right:Nn \l__planar_nf_str { ,~ } }
    \bool_set_false:N \l__planar_first_bool
  }
\cs_new_protected:Npn \__planar_nf_flush:
  {
    \int_compare:nNnT \l__planar_k_int > 0
      {
        \__planar_nf_sep:
        \str_put_right:Ne \l__planar_nf_str
          {
            \l__planar_last_tl
            \int_compare:nNnT \l__planar_k_int > 1
              { \c_circumflex_str \int_use:N \l__planar_k_int }
          }
      }
    \int_zero:N \l__planar_k_int
    \tl_clear:N \l__planar_last_tl
  }
\cs_generate_variant:Nn \str_if_eq:nnF { Vn }

% ---------------------------------------------------------------------------
% Layout
%
% Strands on a seam sit at positions (in units of `strand sep') that are
% strictly increasing, with gaps of at least 1 and larger gaps next to discs.
% Each layer predicts where the strands on the neighbouring seams would like
% to be (a straight strand keeps its position, a disc centres its outputs
% under its inputs, a cap goes next to its neighbours, ...); the positions
% are the best fit to these wishes under the gap constraints, found by
% isotonic regression (pool adjacent violators).  A few sweeps back and forth
% let both neighbours of a seam have their say.
% ---------------------------------------------------------------------------
\cs_new:Npn \__planar_key:nn #1#2 { \int_eval:n {#1} . \int_eval:n {#2} }

% Sizes of the discs (half width and half height, in cm) and of the layers.
\cs_new_protected:Npn \__planar_measure:n #1
  {
    \hbox_set:Nn \l__planar_tmp_box {#1}
    \fp_set:Nn \l__planar_wd_fp
      {
        \dim_to_fp:n { \box_wd:N \l__planar_tmp_box }
        / \dim_to_fp:n { 1cm } / \l__planar_scale_fp
      }
    \fp_set:Nn \l__planar_ht_fp
      {
        \dim_to_fp:n { \box_ht:N \l__planar_tmp_box + \box_dp:N \l__planar_tmp_box }
        / \dim_to_fp:n { 1cm } / \l__planar_scale_fp
      }
  }
\cs_new_protected:Npn \__planar_box_sizes:
  {
    \prop_clear:N \l__planar_bwidth_prop
    \prop_clear:N \l__planar_bheight_prop
    \prop_clear:N \l__planar_h_prop
    \fp_set:Nn \l__planar_star_fp { \bool_if:NTF \l__planar_stars_bool { 0.3 } { 0 } }
    \seq_map_indexed_inline:Nn \l__planar_layers_seq
      {
        \fp_set_eq:NN \l__planar_h_fp \l__planar_L_fp
        \int_zero:N \l__planar_j_int
        \tl_map_inline:nn {##2}
          {
            \int_incr:N \l__planar_j_int
            \str_if_eq:eeT { \__planar_type:n {####1} } { box }
              {
                \__planar_box_size:nnnn ####1
                \prop_put:Nee \l__planar_bwidth_prop
                  { \__planar_key:nn {##1} { \l__planar_j_int } } { \fp_use:N \l__planar_bw_fp }
                \prop_put:Nee \l__planar_bheight_prop
                  { \__planar_key:nn {##1} { \l__planar_j_int } } { \fp_use:N \l__planar_bh_fp }
                \fp_set:Nn \l__planar_h_fp
                  {
                    max ( \l__planar_h_fp ,
                      2 * \l__planar_bh_fp + 2 * \c__planar_legroom_fp )
                  }
              }
          }
        \prop_put:Nne \l__planar_h_prop {##1} { \fp_use:N \l__planar_h_fp }
      }
  }
\fp_new:N \l__planar_h_fp
\cs_new_protected:Npn \__planar_box_size:nnnn #1#2#3#4
  {
    \tl_if_blank:nTF {#4}
      {
        \fp_zero:N \l__planar_wd_fp
        \fp_zero:N \l__planar_ht_fp
      }
      { \__planar_measure:n { \l__planar_labelfont_tl \ensuremath {#4} } }
    \int_set:Nn \l__planar_k_int { \int_max:nn {#2} {#3} }
    \str_if_eq:VnTF \l__planar_boxshape_tl { circle }
      {
        \fp_set:Nn \l__planar_bw_fp
          {
            max ( \l__planar_boxmin_fp ,
              0.5 * sqrt ( \l__planar_wd_fp ^ 2 + \l__planar_ht_fp ^ 2 ) + 0.05 ,
              0.11 * \l__planar_k_int )
          }
        \fp_set_eq:NN \l__planar_bh_fp \l__planar_bw_fp
      }
      {
        \fp_set:Nn \l__planar_bw_fp
          {
            max ( \l__planar_boxmin_fp , 0.5 * \l__planar_wd_fp + 0.1 ,
              0.4 * ( \l__planar_k_int - 1 ) * \l__planar_s_fp + 0.12 )
          }
        \fp_set:Nn \l__planar_bh_fp
          { max ( 0.8 * \l__planar_boxmin_fp , 0.5 * \l__planar_ht_fp + 0.08 ) }
      }
  }
\cs_generate_variant:Nn \str_if_eq:nnTF { Vn }

% Minimal gaps between neighbouring strands on every seam.
\cs_new_protected:Npn \__planar_all_gaps:
  {
    \prop_clear:N \l__planar_gaps_prop
    \int_step_inline:nnn { 0 } { \l__planar_N_int } { \__planar_seam_gaps:n {##1} }
  }
\cs_new_protected:Npn \__planar_seam_gaps:n #1
  {
    \prop_clear:N \l__planar_g_prop
    \int_step_inline:nn { \__planar_count:n {#1} - 1 }
      { \prop_put:Nnn \l__planar_g_prop {##1} { 1 } }
    \int_compare:nNnT {#1} > 0 { \__planar_side_gaps:nn {#1} { out } }
    \int_compare:nNnT {#1} < \l__planar_N_int
      { \__planar_side_gaps:nn { #1 + 1 } { in } }
    \clist_clear:N \l__planar_tmp_clist
    \int_step_inline:nn { \__planar_count:n {#1} - 1 }
      {
        \clist_put_right:Ne \l__planar_tmp_clist
          { \prop_item:Nn \l__planar_g_prop {##1} }
      }
    \prop_put:NeV \l__planar_gaps_prop { \int_eval:n {#1} } \l__planar_tmp_clist
  }
% Room needed by item #2 (number #3 of layer #1) on side #4 with #5 points.
\cs_new_protected:Npn \__planar_room:nnnnn #1#2#3#4#5
  {
    \str_if_eq:eeTF { \__planar_type:n {#2} } { box }
      {
        \fp_set:Nn \l__planar_w_fp
          {
            ( \prop_item:Ne \l__planar_bwidth_prop { \__planar_key:nn {#1} {#3} }
              + \c__planar_clear_fp ) / \l__planar_s_fp
          }
        \fp_set:Nn \l__planar_tmp_fp { \l__planar_star_fp / \l__planar_s_fp }
        \fp_set:Nn \l__planar_lamR_fp
          { max ( 0.5 , \l__planar_w_fp - ( #5 - 1 ) / 2 ) }
        \fp_set:Nn \l__planar_lamL_fp { \l__planar_lamR_fp + \l__planar_tmp_fp }
        \fp_set:Nn \l__planar_zero_fp
          { 2 * \l__planar_w_fp + \l__planar_tmp_fp }
      }
      {
        \fp_set:Nn \l__planar_lamL_fp { 0.5 }
        \fp_set:Nn \l__planar_lamR_fp { 0.5 }
        \fp_set:Nn \l__planar_zero_fp { 2 }
      }
  }
\cs_new_protected:Npn \__planar_side_gaps:nn #1#2
  {
    \int_zero:N \l__planar_idx_int
    \int_zero:N \l__planar_j_int
    \fp_zero:N \l__planar_pend_fp
    \fp_zero:N \l__planar_lastR_fp
    \tl_set:Ne \l__planar_tmpb_tl { \__planar_layer:n {#1} }
    \tl_map_inline:Nn \l__planar_tmpb_tl
      {
        \int_incr:N \l__planar_j_int
        \int_set:Nn \l__planar_c_int
          { \str_if_eq:nnTF {#2} { in } { \__planar_in:n {##1} } { \__planar_out:n {##1} } }
        \__planar_room:nnnnn {#1} {##1} { \l__planar_j_int } {#2} { \l__planar_c_int }
        \int_compare:nNnTF \l__planar_c_int > 0
          {
            \int_compare:nNnT \l__planar_idx_int > 0
              {
                \prop_put:Nee \l__planar_g_prop { \int_use:N \l__planar_idx_int }
                  {
                    \fp_eval:n
                      {
                        max ( \prop_item:Ne \l__planar_g_prop { \int_use:N \l__planar_idx_int } ,
                          \l__planar_lastR_fp + \l__planar_pend_fp + \l__planar_lamL_fp )
                      }
                  }
              }
            \int_add:Nn \l__planar_idx_int { \l__planar_c_int }
            \fp_set_eq:NN \l__planar_lastR_fp \l__planar_lamR_fp
            \fp_zero:N \l__planar_pend_fp
          }
          { \fp_add:Nn \l__planar_pend_fp { \l__planar_zero_fp } }
      }
  }

\cs_new:Npn \__planar_src:n #1
  { \clist_item:Nn \l__planar_src_clist { \l__planar_idx_int + #1 } }
\cs_new_protected:Npn \__planar_push:nn #1#2
  {
    \tl_set:Ne \l__planar_last_tl { \fp_eval:n {#1} }
    \seq_put_right:NV \l__planar_pred_seq \l__planar_last_tl
    \seq_put_right:Ne \l__planar_predw_seq { \fp_eval:n {#2} }
  }
% Generators without inputs have no natural place: put them next to the
% previous output, or just before the next input.
\cs_new_protected:Npn \__planar_push_free:n #1
  {
    \tl_if_empty:NTF \l__planar_last_tl
      {
        \int_compare:nNnTF \l__planar_idx_int > \l__planar_len_int
          {
            \int_compare:nNnTF \l__planar_len_int > 0
              {
                \tl_set:Ne \l__planar_tmp_tl
                  { \fp_eval:n { \clist_item:Nn \l__planar_src_clist { \l__planar_len_int } + 1 } }
              }
              { \tl_set:Nn \l__planar_tmp_tl { 0 } }
          }
          {
            \tl_set:Ne \l__planar_tmp_tl
              { \fp_eval:n { \__planar_src:n { 0 } - #1 } }
          }
      }
      { \tl_set:Ne \l__planar_tmp_tl { \fp_eval:n { \l__planar_last_tl + 1 } } }
    \int_step_inline:nnn { 0 } { #1 - 1 }
      { \__planar_push:nn { \l__planar_tmp_tl + ##1 } { \c__planar_free_fp } }
  }

% Predictions for seam #1 from seam #1 - 1 (#2 = f) or from seam #1 + 1
% (#2 = b, reading the layer backwards).
\cs_new_protected:Npn \__planar_predict:nn #1#2
  {
    \seq_clear:N \l__planar_pred_seq
    \seq_clear:N \l__planar_predw_seq
    \str_if_eq:nnTF {#2} { f }
      {
        \prop_get:NeN \l__planar_pos_prop { \int_eval:n { #1 - 1 } } \l__planar_src_clist
        \tl_set:Ne \l__planar_tmpb_tl { \__planar_layer:n {#1} }
        \bool_set_false:N \l__planar_mirror_bool
      }
      {
        \prop_get:NeN \l__planar_pos_prop { \int_eval:n { #1 + 1 } } \l__planar_src_clist
        \tl_set:Ne \l__planar_tmpb_tl { \__planar_layer:n { #1 + 1 } }
        \bool_set_true:N \l__planar_mirror_bool
      }
    \int_set:Nn \l__planar_len_int { \clist_count:N \l__planar_src_clist }
    \int_set:Nn \l__planar_idx_int { 1 }
    \tl_clear:N \l__planar_last_tl
    \tl_map_inline:Nn \l__planar_tmpb_tl
      {
        \bool_if:NTF \l__planar_mirror_bool
          {
            \int_set:Nn \l__planar_pa_int { \__planar_out:n {##1} }
            \int_set:Nn \l__planar_pb_int { \__planar_in:n {##1} }
          }
          {
            \int_set:Nn \l__planar_pa_int { \__planar_in:n {##1} }
            \int_set:Nn \l__planar_pb_int { \__planar_out:n {##1} }
          }
        \int_compare:nNnTF \l__planar_pa_int > 0
          {
            \int_compare:nNnT \l__planar_pb_int > 0
              {
                \fp_zero:N \l__planar_mean_fp
                \int_step_inline:nn { \l__planar_pa_int }
                  { \fp_add:Nn \l__planar_mean_fp { \__planar_src:n { ####1 - 1 } } }
                \fp_set:Nn \l__planar_mean_fp { \l__planar_mean_fp / \l__planar_pa_int }
                \int_step_inline:nn { \l__planar_pb_int }
                  {
                    \__planar_push:nn
                      { \l__planar_mean_fp + ####1 - ( \l__planar_pb_int + 1 ) / 2 } { 1 }
                  }
              }
          }
          {
            \int_compare:nNnT \l__planar_pb_int > 0
              { \__planar_push_free:n { \l__planar_pb_int } }
          }
        \int_add:Nn \l__planar_idx_int { \l__planar_pa_int }
      }
  }

% Place the strands of seam #1 using the predictions from the previous
% (#2 = true) and/or the next (#3 = true) layer.
\cs_new_protected:Npn \__planar_place:nnn #1#2#3
  {
    \seq_clear:N \l__planar_ideal_seq
    \seq_clear:N \l__planar_weight_seq
    \bool_if:nT { #2 && \int_compare_p:nNn {#1} > 0 }
      {
        \__planar_predict:nn {#1} { f }
        \seq_set_eq:NN \l__planar_ideal_seq \l__planar_pred_seq
        \seq_set_eq:NN \l__planar_weight_seq \l__planar_predw_seq
      }
    \bool_if:nT { #3 && \int_compare_p:nNn {#1} < \l__planar_N_int }
      {
        \__planar_predict:nn {#1} { b }
        \seq_if_empty:NTF \l__planar_ideal_seq
          {
            \seq_set_eq:NN \l__planar_ideal_seq \l__planar_pred_seq
            \seq_set_eq:NN \l__planar_weight_seq \l__planar_predw_seq
          }
          {
            \seq_set_eq:NN \l__planar_fpred_seq \l__planar_ideal_seq
            \seq_set_eq:NN \l__planar_fw_seq \l__planar_weight_seq
            \seq_clear:N \l__planar_ideal_seq
            \seq_clear:N \l__planar_weight_seq
            \seq_map_indexed_inline:Nn \l__planar_fpred_seq
              {
                \tl_set:Ne \l__planar_ta_tl { \seq_item:Nn \l__planar_fw_seq {##1} }
                \tl_set:Ne \l__planar_tb_tl { \seq_item:Nn \l__planar_predw_seq {##1} }
                \seq_put_right:Ne \l__planar_ideal_seq
                  {
                    \fp_eval:n
                      {
                        ( \l__planar_ta_tl * ##2 + \l__planar_tb_tl *
                          \seq_item:Nn \l__planar_pred_seq {##1} )
                        / ( \l__planar_ta_tl + \l__planar_tb_tl )
                      }
                  }
                \seq_put_right:Ne \l__planar_weight_seq
                  { \fp_eval:n { \l__planar_ta_tl + \l__planar_tb_tl } }
              }
          }
      }
    \seq_if_empty:NF \l__planar_ideal_seq
      {
        \__planar_pava:n {#1}
        \prop_put:NeV \l__planar_pos_prop { \int_eval:n {#1} } \l__planar_tmp_clist
      }
  }

% Isotonic regression with minimal gaps g_i: minimise sum w_i (y_i - x_i)^2
% subject to y_{i+1} >= y_i + g_i.  With z_i = y_i - G_i (G_i the sum of the
% first i - 1 gaps) this asks for a non-decreasing z, which is what
% pool-adjacent-violators computes.
\cs_new_protected:Npn \__planar_cumulative_gaps:n #1
  {
    \prop_get:NeN \l__planar_gaps_prop { \int_eval:n {#1} } \l__planar_gap_clist
    \seq_clear:N \l__planar_G_seq
    \fp_zero:N \l__planar_acc_fp
    \seq_put_right:Nn \l__planar_G_seq { 0 }
    \clist_map_inline:Nn \l__planar_gap_clist
      {
        \fp_add:Nn \l__planar_acc_fp {##1}
        \seq_put_right:Ne \l__planar_G_seq { \fp_use:N \l__planar_acc_fp }
      }
  }
\cs_new_protected:Npn \__planar_pava:n #1
  {
    \__planar_cumulative_gaps:n {#1}
    \seq_clear:N \l__planar_bs_seq
    \seq_clear:N \l__planar_bw_seq
    \seq_clear:N \l__planar_bn_seq
    \seq_map_indexed_inline:Nn \l__planar_ideal_seq
      {
        \tl_set:Ne \l__planar_tb_tl { \seq_item:Nn \l__planar_weight_seq {##1} }
        \seq_put_right:Ne \l__planar_bs_seq
          { \fp_eval:n { \l__planar_tb_tl * ( ##2 - \seq_item:Nn \l__planar_G_seq {##1} ) } }
        \seq_put_right:NV \l__planar_bw_seq \l__planar_tb_tl
        \seq_put_right:Nn \l__planar_bn_seq { 1 }
        \__planar_pava_merge:
      }
    \clist_clear:N \l__planar_tmp_clist
    \int_zero:N \l__planar_i_int
    \seq_map_indexed_inline:Nn \l__planar_bs_seq
      {
        \tl_set:Ne \l__planar_ta_tl
          { \fp_eval:n { ##2 / ( \seq_item:Nn \l__planar_bw_seq {##1} ) } }
        \prg_replicate:nn { \seq_item:Nn \l__planar_bn_seq {##1} }
          {
            \int_incr:N \l__planar_i_int
            \clist_put_right:Ne \l__planar_tmp_clist
              {
                \fp_eval:n
                  {
                    round ( \l__planar_ta_tl +
                      \seq_item:Nn \l__planar_G_seq { \l__planar_i_int } , 5 )
                  }
              }
          }
      }
  }
\cs_new_protected:Npn \__planar_pava_merge:
  {
    \int_compare:nNnT { \seq_count:N \l__planar_bs_seq } > 1
      {
        \seq_pop_right:NN \l__planar_bs_seq \l__planar_ta_tl
        \seq_pop_right:NN \l__planar_bw_seq \l__planar_tb_tl
        \seq_pop_right:NN \l__planar_bn_seq \l__planar_x_tl
        \seq_get_right:NN \l__planar_bs_seq \l__planar_p_tl
        \seq_get_right:NN \l__planar_bw_seq \l__planar_q_tl
        \fp_compare:nNnTF
          { \l__planar_p_tl / \l__planar_q_tl }
          > { \l__planar_ta_tl / \l__planar_tb_tl + 1e-9 }
          {
            \seq_pop_right:NN \l__planar_bs_seq \l__planar_p_tl
            \seq_pop_right:NN \l__planar_bw_seq \l__planar_q_tl
            \seq_pop_right:NN \l__planar_bn_seq \l__planar_y_tl
            \seq_put_right:Ne \l__planar_bs_seq
              { \fp_eval:n { \l__planar_p_tl + \l__planar_ta_tl } }
            \seq_put_right:Ne \l__planar_bw_seq
              { \fp_eval:n { \l__planar_q_tl + \l__planar_tb_tl } }
            \seq_put_right:Ne \l__planar_bn_seq
              { \int_eval:n { \l__planar_y_tl + \l__planar_x_tl } }
            \__planar_pava_merge:
          }
          {
            \seq_put_right:NV \l__planar_bs_seq \l__planar_ta_tl
            \seq_put_right:NV \l__planar_bw_seq \l__planar_tb_tl
            \seq_put_right:NV \l__planar_bn_seq \l__planar_x_tl
          }
      }
  }

\cs_new_protected:Npn \__planar_layout:
  {
    \prop_clear:N \l__planar_pos_prop
    \__planar_cumulative_gaps:n { 0 }
    \clist_clear:N \l__planar_tmp_clist
    \int_step_inline:nn { \__planar_count:n { 0 } }
      { \clist_put_right:Ne \l__planar_tmp_clist { \seq_item:Nn \l__planar_G_seq {##1} } }
    \prop_put:NnV \l__planar_pos_prop { 0 } \l__planar_tmp_clist
    \int_step_inline:nn { \l__planar_N_int }
      {
        \prop_put:Nnn \l__planar_pos_prop {##1} { }
        \__planar_place:nnn {##1} { \c_true_bool } { \c_false_bool }
      }
    \__planar_smooth:n { 4 }
  }
\cs_new_protected:Npn \__planar_smooth:n #1
  {
    \int_compare:nNnT {#1} > 0
      {
        \tl_set:Ne \l__planar_sig_tl { \__planar_signature: }
        \int_step_inline:nnnn { \l__planar_N_int } { -1 } { 0 }
          { \__planar_place:nnn {##1} { \c_true_bool } { \c_true_bool } }
        \int_step_inline:nnn { 0 } { \l__planar_N_int }
          { \__planar_place:nnn {##1} { \c_true_bool } { \c_true_bool } }
        \tl_set:Ne \l__planar_tmp_tl { \__planar_signature: }
        \tl_if_eq:NNF \l__planar_sig_tl \l__planar_tmp_tl
          { \__planar_smooth:n { #1 - 1 } }
      }
  }
\cs_new:Npn \__planar_signature:
  { \prop_map_function:NN \l__planar_pos_prop \__planar_signature:nn }
\cs_new:Npn \__planar_signature:nn #1#2 { #1 : #2 ; }

% Heights of the seams (u, in cm; seam 0 at u = 0, going down) and the
% centres of the discs.
\cs_new_protected:Npn \__planar_heights:
  {
    \prop_clear:N \l__planar_u_prop
    \fp_zero:N \l__planar_acc_fp
    \prop_put:Nnn \l__planar_u_prop { 0 } { 0 }
    \int_step_inline:nn { \l__planar_N_int }
      {
        \fp_sub:Nn \l__planar_acc_fp { \prop_item:Nn \l__planar_h_prop {##1} }
        \prop_put:Nne \l__planar_u_prop {##1} { \fp_use:N \l__planar_acc_fp }
      }
  }
\cs_new:Npn \__planar_u:n #1 { \prop_item:Ne \l__planar_u_prop { \int_eval:n {#1} } }
\cs_new:Npn \__planar_pos:nn #1#2
  {
    \clist_item:en { \prop_item:Ne \l__planar_pos_prop { \int_eval:n {#1} } } {#2}
  }
\cs_generate_variant:Nn \clist_item:nn { en }

\cs_new_protected:Npn \__planar_centres:
  {
    \prop_clear:N \l__planar_bx_prop
    \prop_clear:N \l__planar_by_prop
    \seq_map_indexed_inline:Nn \l__planar_layers_seq
      {
        \int_zero:N \l__planar_idx_int
        \int_zero:N \l__planar_out_int
        \int_zero:N \l__planar_j_int
        \tl_map_inline:nn {##2}
          {
            \int_incr:N \l__planar_j_int
            \str_if_eq:eeT { \__planar_type:n {####1} } { box }
              { \__planar_centre:nn {##1} {####1} }
            \int_add:Nn \l__planar_idx_int { \__planar_in:n {####1} }
            \int_add:Nn \l__planar_out_int { \__planar_out:n {####1} }
          }
      }
  }
\cs_new_protected:Npn \__planar_centre:nn #1#2
  {
    \int_set:Nn \l__planar_pa_int { \__planar_in:n {#2} }
    \int_set:Nn \l__planar_pb_int { \__planar_out:n {#2} }
    \fp_zero:N \l__planar_acc_fp
    \int_zero:N \l__planar_c_int
    \int_compare:nNnT \l__planar_pa_int > 0
      {
        \fp_zero:N \l__planar_mean_fp
        \int_step_inline:nn { \l__planar_pa_int }
          {
            \fp_add:Nn \l__planar_mean_fp
              { \__planar_pos:nn { #1 - 1 } { \l__planar_idx_int + ##1 } }
          }
        \fp_add:Nn \l__planar_acc_fp { \l__planar_mean_fp / \l__planar_pa_int }
        \int_incr:N \l__planar_c_int
      }
    \int_compare:nNnT \l__planar_pb_int > 0
      {
        \fp_zero:N \l__planar_mean_fp
        \int_step_inline:nn { \l__planar_pb_int }
          {
            \fp_add:Nn \l__planar_mean_fp
              { \__planar_pos:nn {#1} { \l__planar_out_int + ##1 } }
          }
        \fp_add:Nn \l__planar_acc_fp { \l__planar_mean_fp / \l__planar_pb_int }
        \int_incr:N \l__planar_c_int
      }
    \int_compare:nNnT \l__planar_c_int = 0
      {
        \fp_set:Nn \l__planar_w_fp
          {
            ( \prop_item:Ne \l__planar_bwidth_prop
                { \__planar_key:nn {#1} { \l__planar_j_int } }
              + \c__planar_clear_fp ) / \l__planar_s_fp
          }
        \__planar_virtual:nn { #1 - 1 } { \l__planar_idx_int }
        \__planar_virtual:nn {#1} { \l__planar_out_int }
      }
    \fp_set:Nn \l__planar_acc_fp
      {
        \l__planar_s_fp *
        ( \int_compare:nNnTF \l__planar_c_int = 0
            { 0 } { \l__planar_acc_fp / \l__planar_c_int } )
      }
    \prop_put:Nee \l__planar_bx_prop { \__planar_key:nn {#1} { \l__planar_j_int } }
      { \fp_use:N \l__planar_acc_fp }
    \prop_put:Nee \l__planar_by_prop { \__planar_key:nn {#1} { \l__planar_j_int } }
      { \fp_eval:n { ( \__planar_u:n { #1 - 1 } + \__planar_u:n {#1} ) / 2 } }
  }
% A disc without strands sits between its neighbours on seam #1 (#2 strands
% before it).
\cs_new_protected:Npn \__planar_virtual:nn #1#2
  {
    \fp_set:Nn \l__planar_tmp_fp { \l__planar_star_fp / \l__planar_s_fp }
    \bool_lazy_and:nnTF
      { \int_compare_p:nNn {#2} > 0 }
      { \int_compare_p:nNn {#2} < { \__planar_count:n {#1} } }
      {
        \fp_add:Nn \l__planar_acc_fp
          {
            ( \__planar_pos:nn {#1} {#2} + \__planar_pos:nn {#1} { #2 + 1 }
              + \l__planar_tmp_fp ) / 2
          }
        \int_incr:N \l__planar_c_int
      }
      {
        \int_compare:nNnTF {#2} > 0
          {
            \fp_add:Nn \l__planar_acc_fp
              { \__planar_pos:nn {#1} {#2} + 0.5 + \l__planar_tmp_fp + \l__planar_w_fp }
            \int_incr:N \l__planar_c_int
          }
          {
            \int_compare:nNnT { \__planar_count:n {#1} } > 0
              {
                \fp_add:Nn \l__planar_acc_fp
                  { \__planar_pos:nn {#1} { 1 } - 0.5 - \l__planar_w_fp }
                \int_incr:N \l__planar_c_int
              }
          }
      }
  }

% Extent of the picture and the size of the outer disc.
\cs_new_protected:Npn \__planar_extent:
  {
    \fp_set:Nn \l__planar_xmin_fp { inf }
    \fp_set:Nn \l__planar_xmax_fp { -inf }
    \prop_map_inline:Nn \l__planar_pos_prop
      {
        \clist_map_inline:nn {##2}
          {
            \fp_set:Nn \l__planar_xmin_fp
              { min ( \l__planar_xmin_fp , ####1 * \l__planar_s_fp ) }
            \fp_set:Nn \l__planar_xmax_fp
              { max ( \l__planar_xmax_fp , ####1 * \l__planar_s_fp ) }
          }
      }
    \prop_map_inline:Nn \l__planar_bx_prop
      {
        \fp_set:Nn \l__planar_xmin_fp
          {
            min ( \l__planar_xmin_fp , ##2
              - \prop_item:Nn \l__planar_bwidth_prop {##1} - \l__planar_star_fp )
          }
        \fp_set:Nn \l__planar_xmax_fp
          { max ( \l__planar_xmax_fp , ##2 + \prop_item:Nn \l__planar_bwidth_prop {##1} ) }
      }
    \fp_compare:nNnT \l__planar_xmin_fp > \l__planar_xmax_fp
      {
        \fp_zero:N \l__planar_xmin_fp
        \fp_zero:N \l__planar_xmax_fp
      }
    \fp_set:Nn \l__planar_xc_fp { ( \l__planar_xmin_fp + \l__planar_xmax_fp ) / 2 }
    \fp_set:Nn \l__planar_uc_fp { \__planar_u:n { \l__planar_N_int } / 2 }
    \fp_set:Nn \l__planar_hwc_fp { ( \l__planar_xmax_fp - \l__planar_xmin_fp ) / 2 }
    \fp_set:Nn \l__planar_hw_fp { \l__planar_hwc_fp + \l__planar_margin_fp }
    \fp_set:Nn \l__planar_hh_fp
      { max ( - \l__planar_uc_fp + 0.6 * \l__planar_margin_fp , 0.35 ) }
    \fp_set:Nn \l__planar_dl_fp
      { \l__planar_hwc_fp + \bool_if:NTF \l__planar_stars_bool { 0.42 } { 0.15 } }
    \str_case:Vn \l__planar_outer_tl
      {
        { circle }
          {
            \fp_set:Nn \l__planar_A_fp
              {
                max ( sqrt ( \l__planar_hw_fp ^ 2 + \l__planar_hh_fp ^ 2 ) ,
                  \l__planar_dl_fp , 0.5 )
              }
            \fp_set_eq:NN \l__planar_B_fp \l__planar_A_fp
          }
        { ellipse }
          {
            \fp_set:Nn \l__planar_A_fp
              { max ( 1.4142 * \l__planar_hw_fp , \l__planar_dl_fp , 0.5 ) }
            \fp_set:Nn \l__planar_B_fp { 1.4142 * \l__planar_hh_fp }
          }
        { rectangle }
          {
            \fp_set:Nn \l__planar_A_fp
              { max ( \l__planar_hw_fp , \l__planar_dl_fp , 0.45 ) }
            \fp_set_eq:NN \l__planar_B_fp \l__planar_hh_fp
          }
        { none }
          {
            \fp_set:Nn \l__planar_A_fp { max ( \l__planar_hw_fp , 0.3 ) }
            \fp_set_eq:NN \l__planar_B_fp \l__planar_hh_fp
          }
      }
    \fp_set:Nn \l__planar_F_fp { \l__planar_A_fp + \l__planar_B_fp + 2 }
    \bool_if:NTF \l__planar_vertical_bool
      {
        \fp_set:Nn \l__planar_pagew_fp { 2 * \l__planar_A_fp }
        \fp_set:Nn \l__planar_pageh_fp { 2 * \l__planar_B_fp }
      }
      {
        \fp_set:Nn \l__planar_pagew_fp { 2 * \l__planar_B_fp }
        \fp_set:Nn \l__planar_pageh_fp { 2 * \l__planar_A_fp }
      }
  }
\cs_generate_variant:Nn \str_case:nn { V }

% ---------------------------------------------------------------------------
% Drawing
%
% Everything is drawn in local coordinates (x across the strands, u along the
% composition, both in cm), centred on the outer disc and then mapped to the
% page by the orientation.  Each layer is a horizontal slab.  The shaded
% regions of a slab are filled with the even-odd rule: every piece of string
% is closed up outside the slab (above, below or far to the left), so that
% crossing a string inside the slab always switches between shaded and
% unshaded; the region on the far left, at the star of the outer disc, is
% then fixed by the parity of the pieces closed on the left.
% ---------------------------------------------------------------------------
\cs_new:Npn \__planar_P:nn #1#2
  {
    ( \fp_eval:n { round ( (#1) - \l__planar_xc_fp , 4 ) } ,
      \fp_eval:n { round ( (#2) - \l__planar_uc_fp , 4 ) } )
  }
\cs_new:Npn \__planar_far_left: { \l__planar_xc_fp - \l__planar_F_fp - 1 }
\cs_new:Npn \__planar_bez:nnnnnnnn #1#2#3#4#5#6#7#8
  {
    \__planar_P:nn {#1} {#2} ~ .. ~ controls ~ \__planar_P:nn {#3} {#4} ~ and ~
    \__planar_P:nn {#5} {#6} ~ .. ~ \__planar_P:nn {#7} {#8}
  }
\cs_new:Npn \__planar_top:n #1
  { \fp_eval:n { \l__planar_s_fp * \clist_item:Nn \l__planar_top_clist {#1} } }
\cs_new:Npn \__planar_bot:n #1
  { \fp_eval:n { \l__planar_s_fp * \clist_item:Nn \l__planar_bot_clist {#1} } }

% Slab #1 (from u = #2 down to u = #3) whose closed pieces are in
% \l__planar_path_tl, #4 of them closed on the left.
\cs_new_protected:Npn \__planar_shade_slab:nnn #1#2#3
  {
    \bool_xor:nnT { \int_if_odd_p:n {#3} } { \l__planar_negative_bool }
      {
        \tl_put_right:Ne \l__planar_path_tl
          {
            \__planar_P:nn { \__planar_far_left: - 1 } { #2 - 2 }
            ~ rectangle ~
            \__planar_P:nn { \l__planar_xc_fp + \l__planar_F_fp + 2 } { #1 + 2 }
          }
      }
    \tl_if_empty:NF \l__planar_path_tl
      {
        \tl_put_right:Ne \l__planar_shade_tl
          {
            \exp_not:N \scope
            \exp_not:N \clip
              \__planar_P:nn { \l__planar_xc_fp - \l__planar_F_fp } { #2 - \c__planar_clip_fp }
              ~ rectangle ~
              \__planar_P:nn { \l__planar_xc_fp + \l__planar_F_fp } { #1 + \c__planar_clip_fp } ;
            \exp_not:N \fill [ pa~shaded , even~odd~rule ]
              \exp_not:V \l__planar_path_tl ;
            \exp_not:N \endscope
          }
      }
  }

% A straight strand from (#1, #3) down to (#2, #4).
\cs_new_protected:Npn \__planar_piece_id:nnnn #1#2#3#4
  {
    \tl_set:Ne \l__planar_pt_tl
      {
        \__planar_bez:nnnnnnnn {#1} {#3} {#1} { ( #3 + #4 ) / 2 }
          {#2} { ( #3 + #4 ) / 2 } {#2} {#4}
      }
    \tl_put_right:Ne \l__planar_strings_tl
      { \exp_not:N \draw [ pa~string ] \exp_not:V \l__planar_pt_tl ; }
    \tl_put_right:Ne \l__planar_path_tl
      {
        \__planar_P:nn {#1} { #3 + \c__planar_ext_fp } --
        \exp_not:V \l__planar_pt_tl --
        \__planar_P:nn {#2} { #4 - \c__planar_ext_fp } --
        \__planar_P:nn { \__planar_far_left: } { #4 - \c__planar_ext_fp } --
        \__planar_P:nn { \__planar_far_left: } { #3 + \c__planar_ext_fp } -- cycle ~
      }
    \int_incr:N \l__planar_through_int
  }
% A cup (#5 = 1) hanging from the points #1, #2 at height #3, or a cap
% (#5 = -1) standing on them; #4 is the height of the layer.
\cs_new_protected:Npn \__planar_piece_turn:nnnnn #1#2#3#4#5
  {
    \fp_set:Nn \l__planar_d_fp
      { 1.3333 * min ( 0.62 * #4 , 0.5 * ( #2 - #1 ) + 0.06 ) }
    \tl_set:Ne \l__planar_pt_tl
      {
        \__planar_bez:nnnnnnnn {#1} {#3}
          {#1} { #3 - #5 * \l__planar_d_fp }
          {#2} { #3 - #5 * \l__planar_d_fp } {#2} {#3}
      }
    \tl_put_right:Ne \l__planar_strings_tl
      { \exp_not:N \draw [ pa~string ] \exp_not:V \l__planar_pt_tl ; }
    \tl_put_right:Ne \l__planar_path_tl
      {
        \__planar_P:nn {#1} { #3 + #5 * \c__planar_ext_fp } --
        \exp_not:V \l__planar_pt_tl --
        \__planar_P:nn {#2} { #3 + #5 * \c__planar_ext_fp } -- cycle ~
      }
  }

% Legs of disc #1 (key) at (cx, cy): a leg from the seam point (#3, #4) on
% side #2 (t or b), attached to the disc at angle #5 (or at x = #5 for
% rectangular discs).
\cs_new_protected:Npn \__planar_leg:nnnnn #1#2#3#4#5
  {
    \str_if_eq:VnTF \l__planar_boxshape_tl { circle }
      {
        \fp_set:Nn \l__planar_ax_fp { \l__planar_cx_fp + \l__planar_bw_fp * cosd (#5) }
        \fp_set:Nn \l__planar_au_fp { \l__planar_cy_fp + \l__planar_bw_fp * sind (#5) }
        \fp_set:Nn \l__planar_phi_fp { cosd (#5) }
        \fp_set:Nn \l__planar_tmp_fp { sind (#5) }
      }
      {
        \fp_set:Nn \l__planar_ax_fp {#5}
        \fp_set:Nn \l__planar_au_fp
          {
            \l__planar_cy_fp +
            \str_if_eq:nnTF {#2} { t } { 1 } { -1 } * \l__planar_bh_fp
          }
        \fp_set:Nn \l__planar_phi_fp { 0 }
        \fp_set:Nn \l__planar_tmp_fp { \str_if_eq:nnTF {#2} { t } { 1 } { -1 } }
      }
    \fp_set:Nn \l__planar_d_fp { 0.45 * abs ( #4 - \l__planar_au_fp ) }
    \tl_set:Ne \l__planar_x_tl
      {
        \__planar_bez:nnnnnnnn {#3} {#4}
          {#3} { #4 - \str_if_eq:nnTF {#2} { t } { 1 } { -1 } * \l__planar_d_fp }
          { \l__planar_ax_fp + \l__planar_d_fp * \l__planar_phi_fp }
          { \l__planar_au_fp + \l__planar_d_fp * \l__planar_tmp_fp }
          { \l__planar_ax_fp } { \l__planar_au_fp }
      }
    \tl_set:Ne \l__planar_y_tl
      {
        \__planar_bez:nnnnnnnn
          { \l__planar_ax_fp } { \l__planar_au_fp }
          { \l__planar_ax_fp + \l__planar_d_fp * \l__planar_phi_fp }
          { \l__planar_au_fp + \l__planar_d_fp * \l__planar_tmp_fp }
          {#3} { #4 - \str_if_eq:nnTF {#2} { t } { 1 } { -1 } * \l__planar_d_fp }
          {#3} {#4}
      }
    \tl_put_right:Ne \l__planar_strings_tl
      { \exp_not:N \draw [ pa~string ] \exp_not:V \l__planar_x_tl ; }
    \seq_put_right:Ne \l__planar_legs_seq
      {
        {#2}
        { \__planar_P:nn {#3} { #4 + \str_if_eq:nnTF {#2} { t } { 1 } { -1 } * \c__planar_ext_fp } }
        { \exp_not:V \l__planar_x_tl }
        { \exp_not:V \l__planar_y_tl }
      }
  }
% Angle of leg #1 of #2 on the top (#3 = 1) or bottom (#3 = -1).
\cs_new:Npn \__planar_angle:nnn #1#2#3
  {
    \int_compare:nNnTF {#2} > 1
      {
        \fp_eval:n
          {
            90 * #3 + #3 * min ( 65 , 30 * ( #2 - 1 ) )
              * ( 1 - 2 * ( #1 - 1 ) / ( #2 - 1 ) )
          }
      }
      { \fp_eval:n { 90 * #3 } }
  }
% Attachment point (x) of leg #1 of #2 on a rectangular disc.
\cs_new:Npn \__planar_attach:nn #1#2
  {
    \int_compare:nNnTF {#2} > 1
      {
        \fp_eval:n
          {
            \l__planar_cx_fp + ( #1 - ( #2 + 1 ) / 2 ) *
              min ( \l__planar_s_fp , ( 2 * \l__planar_bw_fp - 0.24 ) / ( #2 - 1 ) )
          }
      }
      { \fp_use:N \l__planar_cx_fp }
  }

% The disc: item #2, number #3 in the reading order, key #1.
\cs_new_protected:Npn \__planar_piece_box:nnn #1#2#3
  {
    \fp_set:Nn \l__planar_cx_fp { \prop_item:Ne \l__planar_bx_prop {#1} }
    \fp_set:Nn \l__planar_cy_fp { \prop_item:Ne \l__planar_by_prop {#1} }
    \fp_set:Nn \l__planar_bw_fp { \prop_item:Ne \l__planar_bwidth_prop {#1} }
    \fp_set:Nn \l__planar_bh_fp { \prop_item:Ne \l__planar_bheight_prop {#1} }
    \int_set:Nn \l__planar_pa_int { \__planar_in:n {#2} }
    \int_set:Nn \l__planar_pb_int { \__planar_out:n {#2} }
    \seq_clear:N \l__planar_legs_seq
    % legs in clockwise order from the star: top left to right, bottom right
    % to left
    \int_step_inline:nn { \l__planar_pa_int }
      {
        \__planar_leg:nnnnn {#1} { t }
          { \__planar_top:n { \l__planar_idx_int + ##1 } } { \l__planar_ta_tl }
          {
            \str_if_eq:VnTF \l__planar_boxshape_tl { circle }
              { \__planar_angle:nnn {##1} { \l__planar_pa_int } { 1 } }
              { \__planar_attach:nn {##1} { \l__planar_pa_int } }
          }
      }
    \int_step_inline:nnnn { \l__planar_pb_int } { -1 } { 1 }
      {
        \__planar_leg:nnnnn {#1} { b }
          { \__planar_bot:n { \l__planar_out_int + ##1 } } { \l__planar_tb_tl }
          {
            \str_if_eq:VnTF \l__planar_boxshape_tl { circle }
              {
                \__planar_angle:nnn {##1} { \l__planar_pb_int } { -1 }
              }
              { \__planar_attach:nn {##1} { \l__planar_pb_int } }
          }
      }
    \bool_if:NT \l__planar_shade_bool
      {
        \bool_until_do:nn { \seq_if_empty_p:N \l__planar_legs_seq }
          {
            \seq_pop_left:NN \l__planar_legs_seq \l__planar_p_tl
            \seq_pop_left:NN \l__planar_legs_seq \l__planar_q_tl
            \__planar_leg_pair:VV \l__planar_p_tl \l__planar_q_tl
          }
      }
    % the disc itself
    \str_if_eq:VnTF \l__planar_boxshape_tl { circle }
      {
        \tl_put_right:Ne \l__planar_boxes_tl
          {
            \exp_not:N \path [ pa~box ]
              \__planar_P:nn { \l__planar_cx_fp } { \l__planar_cy_fp } ~ circle ~
              [ radius = \fp_eval:n { round ( \l__planar_bw_fp , 4 ) } ] ;
          }
      }
      {
        \tl_put_right:Ne \l__planar_boxes_tl
          {
            \exp_not:N \path [ pa~box ]
              \__planar_P:nn { \l__planar_cx_fp - \l__planar_bw_fp }
                { \l__planar_cy_fp - \l__planar_bh_fp }
              ~ rectangle ~
              \__planar_P:nn { \l__planar_cx_fp + \l__planar_bw_fp }
                { \l__planar_cy_fp + \l__planar_bh_fp } ;
          }
      }
    \tl_set:Ne \l__planar_label_tl { \exp_args:No \exp_not:n { \use_iv:nnnn #2 } }
    \tl_if_blank:VTF \l__planar_label_tl
      {
        \bool_if:NT \l__planar_numbers_bool
          {
            \tl_put_right:Ne \l__planar_boxes_tl
              {
                \exp_not:N \node [ pa~number ] ~ at ~
                  \__planar_P:nn { \l__planar_cx_fp } { \l__planar_cy_fp } {#3} ;
              }
          }
      }
      {
        \tl_put_right:Ne \l__planar_boxes_tl
          {
            \exp_not:N \node [ pa~label ] ~ at ~
              \__planar_P:nn { \l__planar_cx_fp } { \l__planar_cy_fp }
              { \exp_not:V \l__planar_labelfont_tl
                \exp_not:N \ensuremath { \exp_not:V \l__planar_label_tl } } ;
          }
        \bool_if:NT \l__planar_numbers_bool
          {
            \tl_put_right:Ne \l__planar_boxes_tl
              {
                \exp_not:N \node [ pa~number , anchor = south~west ] ~ at ~
                  \__planar_P:nn { \l__planar_cx_fp + 0.75 * \l__planar_bw_fp }
                    { \l__planar_cy_fp + 0.75 * \l__planar_bh_fp } {#3} ;
              }
          }
      }
    \bool_if:NT \l__planar_stars_bool
      {
        \tl_put_right:Ne \l__planar_boxes_tl
          {
            \exp_not:N \node [ pa~star ] ~ at ~
              \__planar_P:nn { \l__planar_cx_fp - \l__planar_bw_fp - 0.15 }
                { \l__planar_cy_fp }
              { \exp_not:N \ensuremath { \exp_not:N \star } } ;
          }
      }
  }
% Two consecutive legs joined through the centre of the disc, closed outside
% the slab.
\cs_new_protected:Npn \__planar_leg_pair:nn #1#2
  { \__planar_leg_pair:nnnnnnnn #1 #2 }
\cs_generate_variant:Nn \__planar_leg_pair:nn { VV }
\cs_new_protected:Npn \__planar_leg_pair:nnnnnnnn #1#2#3#4#5#6#7#8
  {
    \tl_put_right:Nn \l__planar_path_tl { #2 -- #3 -- }
    \tl_put_right:Ne \l__planar_path_tl
      { \__planar_P:nn { \l__planar_cx_fp } { \l__planar_cy_fp } -- }
    \tl_put_right:Nn \l__planar_path_tl { #8 -- #6 }
    \str_if_eq:nnTF {#1} {#5}
      { \tl_put_right:Nn \l__planar_path_tl { -- cycle ~ } }
      {
        \tl_put_right:Ne \l__planar_path_tl
          {
            -- \__planar_P:nn { \__planar_far_left: } { \l__planar_tb_tl - \c__planar_ext_fp }
            -- \__planar_P:nn { \__planar_far_left: } { \l__planar_ta_tl + \c__planar_ext_fp }
            -- cycle ~
          }
        \int_incr:N \l__planar_through_int
      }
  }

% Layer #1.
\cs_new_protected:Npn \__planar_draw_layer:n #1
  {
    \tl_set:Ne \l__planar_ta_tl { \__planar_u:n { #1 - 1 } }
    \tl_set:Ne \l__planar_tb_tl { \__planar_u:n {#1} }
    \prop_get:NeN \l__planar_pos_prop { \int_eval:n { #1 - 1 } } \l__planar_top_clist
    \prop_get:NeN \l__planar_pos_prop { \int_eval:n {#1} } \l__planar_bot_clist
    \int_zero:N \l__planar_idx_int
    \int_zero:N \l__planar_out_int
    \int_zero:N \l__planar_j_int
    \int_zero:N \l__planar_through_int
    \tl_clear:N \l__planar_path_tl
    \tl_set:Ne \l__planar_tmpb_tl { \__planar_layer:n {#1} }
    \tl_map_inline:Nn \l__planar_tmpb_tl
      {
        \int_incr:N \l__planar_j_int
        \str_case:en { \__planar_type:n {##1} }
          {
            { id }
              {
                \__planar_piece_id:nnnn
                  { \__planar_top:n { \l__planar_idx_int + 1 } }
                  { \__planar_bot:n { \l__planar_out_int + 1 } }
                  { \l__planar_ta_tl } { \l__planar_tb_tl }
              }
            { ev }
              {
                \__planar_piece_turn:nnnnn
                  { \__planar_top:n { \l__planar_idx_int + 1 } }
                  { \__planar_top:n { \l__planar_idx_int + 2 } }
                  { \l__planar_ta_tl } { \prop_item:Nn \l__planar_h_prop {#1} } { 1 }
              }
            { coev }
              {
                \__planar_piece_turn:nnnnn
                  { \__planar_bot:n { \l__planar_out_int + 1 } }
                  { \__planar_bot:n { \l__planar_out_int + 2 } }
                  { \l__planar_tb_tl } { \prop_item:Nn \l__planar_h_prop {#1} } { -1 }
              }
            { box }
              {
                \int_incr:N \l__planar_box_int
                \__planar_piece_box:nnn { \__planar_key:nn {#1} { \l__planar_j_int } }
                  {##1} { \int_use:N \l__planar_box_int }
              }
          }
        \int_add:Nn \l__planar_idx_int { \__planar_in:n {##1} }
        \int_add:Nn \l__planar_out_int { \__planar_out:n {##1} }
      }
    \bool_if:NT \l__planar_shade_bool
      {
        \__planar_shade_slab:nnn { \l__planar_ta_tl } { \l__planar_tb_tl }
          { \l__planar_through_int }
      }
  }
\cs_generate_variant:Nn \str_case:nn { e }

% Straight strands from seam #1 to the outer boundary (#2 = 1 up, -1 down).
\cs_new_protected:Npn \__planar_draw_margin:nn #1#2
  {
    \prop_get:NeN \l__planar_pos_prop { \int_eval:n {#1} } \l__planar_top_clist
    \tl_set:Ne \l__planar_ta_tl { \__planar_u:n {#1} }
    \tl_set:Ne \l__planar_tb_tl
      { \fp_eval:n { \l__planar_uc_fp + #2 * ( \l__planar_B_fp + 1 ) } }
    \tl_clear:N \l__planar_path_tl
    \int_zero:N \l__planar_through_int
    \clist_map_inline:Nn \l__planar_top_clist
      {
        \tl_set:Ne \l__planar_x_tl { \fp_eval:n { ##1 * \l__planar_s_fp } }
        \tl_put_right:Ne \l__planar_strings_tl
          {
            \exp_not:N \draw [ pa~string ]
              \__planar_P:nn { \l__planar_x_tl } { \l__planar_ta_tl } --
              \__planar_P:nn { \l__planar_x_tl } { \l__planar_tb_tl } ;
          }
        \tl_put_right:Ne \l__planar_path_tl
          {
            \__planar_P:nn { \l__planar_x_tl } { \l__planar_ta_tl - #2 * \c__planar_ext_fp } --
            \__planar_P:nn { \l__planar_x_tl } { \l__planar_tb_tl + #2 } --
            \__planar_P:nn { \__planar_far_left: } { \l__planar_tb_tl + #2 } --
            \__planar_P:nn { \__planar_far_left: } { \l__planar_ta_tl - #2 * \c__planar_ext_fp }
            -- cycle ~
          }
        \int_incr:N \l__planar_through_int
      }
    \bool_if:NT \l__planar_shade_bool
      {
        \int_compare:nNnTF {#2} > 0
          {
            \__planar_shade_slab:nnn { \l__planar_tb_tl } { \l__planar_ta_tl }
              { \l__planar_through_int }
          }
          {
            \__planar_shade_slab:nnn { \l__planar_ta_tl } { \l__planar_tb_tl }
              { \l__planar_through_int }
          }
      }
  }

% The outer boundary and its star, and the labels of the boundary points.
\cs_new:Npn \__planar_outer_path:
  {
    \str_case:Vn \l__planar_outer_tl
      {
        { circle }
          { (0,0) ~ circle ~ [ radius = \fp_eval:n { round ( \l__planar_A_fp , 4 ) } ] }
        { ellipse }
          {
            (0,0) ~ ellipse ~
            [ x~radius = \fp_eval:n { round ( \l__planar_A_fp , 4 ) } ,
              y~radius = \fp_eval:n { round ( \l__planar_B_fp , 4 ) } ]
          }
        { rectangle } { \__planar_outer_rect: }
        { none } { \__planar_outer_rect: }
      }
  }
\cs_new:Npn \__planar_outer_rect:
  {
    ( \fp_eval:n { round ( - \l__planar_A_fp , 4 ) } ,
      \fp_eval:n { round ( - \l__planar_B_fp , 4 ) } ) ~ rectangle ~
    ( \fp_eval:n { round ( \l__planar_A_fp , 4 ) } ,
      \fp_eval:n { round ( \l__planar_B_fp , 4 ) } )
  }
% Height (centred) where the vertical line at x = #1 (centred) meets the
% boundary.
\cs_new:Npn \__planar_rim:n #1
  {
    \str_case:Vn \l__planar_outer_tl
      {
        { circle }
          { sqrt ( max ( \l__planar_A_fp ^ 2 - ( #1 ) ^ 2 , 0 ) ) }
        { ellipse }
          { \l__planar_B_fp * sqrt ( max ( 1 - ( #1 ) ^ 2 / \l__planar_A_fp ^ 2 , 0 ) ) }
        { rectangle } { \l__planar_B_fp }
        { none } { \l__planar_B_fp }
      }
  }
\cs_new_protected:Npn \__planar_label_point:nnn #1#2#3
  {
    \fp_set:Nn \l__planar_ax_fp { #1 * \l__planar_s_fp - \l__planar_xc_fp }
    \fp_set:Nn \l__planar_au_fp { #2 * ( \__planar_rim:n { \l__planar_ax_fp } ) }
    \fp_set:Nn \l__planar_d_fp
      { 0.22 / max ( sqrt ( \l__planar_ax_fp ^ 2 + \l__planar_au_fp ^ 2 ) , 0.01 ) }
    \tl_put_right:Ne \l__planar_boxes_tl
      {
        \exp_not:N \node [ pa~boundary~label ] ~ at ~
          ( \fp_eval:n { round ( \l__planar_ax_fp * ( 1 + \l__planar_d_fp ) , 4 ) } ,
            \fp_eval:n { round ( \l__planar_au_fp * ( 1 + \l__planar_d_fp ) , 4 ) } )
          {#3} ;
      }
  }
% Number the boundary points clockwise on the page, starting at the star.
\cs_new_protected:Npn \__planar_boundary_labels:
  {
    \int_zero:N \l__planar_k_int
    \prop_get:NnN \l__planar_pos_prop { 0 } \l__planar_top_clist
    \prop_get:NeN \l__planar_pos_prop { \int_use:N \l__planar_N_int } \l__planar_bot_clist
    \bool_xor:nnTF { \l__planar_vertical_bool } { \l__planar_reverse_bool }
      {
        \clist_map_inline:Nn \l__planar_top_clist
          {
            \int_incr:N \l__planar_k_int
            \__planar_label_point:nnn {##1} { 1 } { \int_use:N \l__planar_k_int }
          }
        \clist_reverse:N \l__planar_bot_clist
        \clist_map_inline:Nn \l__planar_bot_clist
          {
            \int_incr:N \l__planar_k_int
            \__planar_label_point:nnn {##1} { -1 } { \int_use:N \l__planar_k_int }
          }
      }
      {
        \clist_map_inline:Nn \l__planar_bot_clist
          {
            \int_incr:N \l__planar_k_int
            \__planar_label_point:nnn {##1} { -1 } { \int_use:N \l__planar_k_int }
          }
        \clist_reverse:N \l__planar_top_clist
        \clist_map_inline:Nn \l__planar_top_clist
          {
            \int_incr:N \l__planar_k_int
            \__planar_label_point:nnn {##1} { 1 } { \int_use:N \l__planar_k_int }
          }
      }
  }

% Orientation: local (x, u) to the page.
\cs_new:Npn \__planar_cm:
  {
    \bool_if:NTF \l__planar_vertical_bool
      { \bool_if:NTF \l__planar_reverse_bool { 1 , 0 , 0 , -1 } { 1 , 0 , 0 , 1 } }
      { \bool_if:NTF \l__planar_reverse_bool { 0 , -1 , 1 , 0 } { 0 , -1 , -1 , 0 } }
  }

\cs_new_protected:Npn \__planar_check_shading:
  {
    \bool_set_eq:NN \l__planar_shade_bool \l__planar_shading_bool
    \bool_if:NT \l__planar_shade_bool
      {
        \int_if_odd:nT { \__planar_count:n { 0 } + \__planar_count:n { \l__planar_N_int } }
          { \bool_set_false:N \l__planar_shade_bool }
        \seq_map_inline:Nn \l__planar_layers_seq
          {
            \tl_map_inline:nn {##1}
              {
                \int_if_odd:nT { \__planar_in:n {####1} + \__planar_out:n {####1} }
                  {
                    \str_if_eq:eeT { \__planar_type:n {####1} } { box }
                      { \bool_set_false:N \l__planar_shade_bool }
                  }
              }
          }
        \bool_if:NF \l__planar_shade_bool
          { \msg_warning:nn { planaralgebra } { no-shading } }
      }
  }

% Draw the word in \l__planar_layers_seq as the next factor of the picture.
\cs_new_protected:Npn \__planar_draw_word:
  {
    \__planar_counts:
    \__planar_check_shading:
    \__planar_box_sizes:
    \__planar_heights:
    \__planar_all_gaps:
    \__planar_layout:
    \__planar_centres:
    \__planar_extent:
    \tl_clear:N \l__planar_shade_tl
    \tl_clear:N \l__planar_strings_tl
    \tl_clear:N \l__planar_boxes_tl
    \int_zero:N \l__planar_box_int
    \__planar_draw_margin:nn { 0 } { 1 }
    \int_step_inline:nn { \l__planar_N_int } { \__planar_draw_layer:n {##1} }
    \__planar_draw_margin:nn { \l__planar_N_int } { -1 }
    \bool_if:NT \l__planar_labels_bool
      {
        \str_if_eq:VnF \l__planar_outer_tl { none }
          { \__planar_boundary_labels: }
      }
    \str_if_eq:VnF \l__planar_outer_tl { none }
      {
        \tl_put_right:Ne \l__planar_boxes_tl
          {
            \exp_not:N \path [ pa~outer ] \__planar_outer_path: ;
          }
        \bool_if:NT \l__planar_stars_bool
          {
            \tl_put_right:Ne \l__planar_boxes_tl
              {
                \exp_not:N \node [ pa~star ] ~ at ~
                  ( \fp_eval:n { round ( - \l__planar_A_fp + 0.2 , 4 ) } , 0 )
                  { \exp_not:N \ensuremath { \exp_not:N \star } } ;
              }
          }
      }
    \tl_put_right:Ne \l__planar_draw_tl
      {
        \exp_not:N \scope
          [ shift = { ( \fp_eval:n { round ( \l__planar_off_fp + \l__planar_pagew_fp / 2 , 4 ) } , 0 ) } ]
        \exp_not:N \scope [ cm = { \__planar_cm: , (0,0) } ]
        \exp_not:N \path \__planar_outer_rect: ;
        \exp_not:N \scope [ overlay ]
        \exp_not:N \clip \__planar_outer_path: ;
        \exp_not:V \l__planar_shade_tl
        \exp_not:V \l__planar_strings_tl
        \exp_not:N \endscope
        \exp_not:V \l__planar_boxes_tl
        \exp_not:N \endscope
        \tl_if_empty:NF \l__planar_caption_tl
          {
            \exp_not:N \node [ pa~name ] ~ at ~
              ( 0 , \fp_eval:n { round ( - \l__planar_pageh_fp / 2 , 4 ) } )
              { \exp_not:V \l__planar_caption_tl } ;
          }
        \exp_not:N \endscope
      }
    \fp_add:Nn \l__planar_off_fp { \l__planar_pagew_fp }
  }

