\cs_generate_variant:Nn \__planar_picture:nn { VV }

% \PAdefine stores the word (after insertions, and reduced with `reduce').
\cs_new_protected:Npn \__planar_store:
  {
    \bool_if:NF \l__planar_error_bool { \__planar_substitute: }
    \bool_if:NF \l__planar_error_bool
      {
        \bool_if:NT \l__planar_reduce_bool
          {
            \__planar_analyse:
            \seq_set_eq:NN \l__planar_layers_seq \l__planar_nf_seq
          }
        \tl_clear:N \l__planar_word_tl
        \seq_map_inline:Nn \l__planar_layers_seq
          { \tl_put_right:Nn \l__planar_word_tl { {##1} } }
        \prop_gput:NVV \g__planar_defs_prop \l__planar_gen_tl \l__planar_word_tl
      }
  }
\cs_generate_variant:Nn \prop_gput:Nnn { NVV }

% ---------------------------------------------------------------------------
% Chains of \PA commands
%
% \PA{2,2}{id, T(1,1)}\PA{2,0}{ev} is one diagram: the first \PA opens a
% group and collects layers; each \PA looks at the next token (skipping
% spaces) and draws the diagram when it is not another \PA.
% ---------------------------------------------------------------------------
\bool_new:N \l__planar_pa_defined_bool
\cs_new_protected:Npn \__planar_layer_cmd:nnn #1#2#3
  {
    \bool_if:NF \g__planar_chain_bool
      {
        \group_begin:
        \bool_gset_true:N \g__planar_chain_bool
        \__planar_start:
      }
    \keys_set:nn { planaralgebra } {#1}
    \__planar_add_layer:nn {#2} {#3}
    \peek_after:Nw \__planar_peek:
  }
\prg_new_conditional:Npnn \__planar_if_layer:N #1 { TF }
  {
    \bool_lazy_or:nnTF
      { \token_if_eq_meaning_p:NN #1 \PAlayer }
      {
        \l__planar_pa_defined_bool &&
        \token_if_eq_meaning_p:NN #1 \PA
      }
      { \prg_return_true: } { \prg_return_false: }
  }
\cs_new_protected:Npn \__planar_peek:
  {
    \__planar_if_layer:NTF \l_peek_token
      { }
      {
        \token_if_eq_catcode:NNTF \l_peek_token \c_space_token
          { \peek_remove_spaces:n { \peek_after:Nw \__planar_peek_after_space: } }
          { \__planar_finish: }
      }
  }
\cs_new_protected:Npn \__planar_peek_after_space:
  {
    \__planar_if_layer:NTF \l_peek_token
      { }
      { \__planar_finish: \c_space_tl }
  }
\cs_new_protected:Npn \__planar_finish:
  {
    \bool_gset_false:N \g__planar_chain_bool
    \bool_if:NTF \l__planar_capture_bool
      { \__planar_store: }
      { \__planar_render: }
    \group_end:
  }

% ---------------------------------------------------------------------------
% The standalone class (as in the temperleylieb and plumber packages)
%
% With the `tikz' (or `multi=tikzpicture') option, standalone makes every
% top-level tikzpicture a cropped page of its own, which cannot be done from
% inside a formula.  So the formula is made the page instead (standalone's
% `math' handling turns \[...\] and \(...\) into pages), and a diagram inside
% a formula is marked as nested so that it never tries to start a page.
% ---------------------------------------------------------------------------
\cs_new_protected:Npn \__planar_standalone_nest:
  {
    \bool_lazy_and:nnT
      { \cs_if_exist_p:N \sa@orig@tikzpicture }
      { \mode_if_math_p: }
      {
        \int_compare:nNnT \sa@internal = 0
          {
            \msg_warning:nn { planaralgebra } { standalone-formula }
            \int_incr:N \sa@internal
          }
      }
  }
\cs_new_protected:Npn \__planar_standalone_math:
  {
    \bool_lazy_all:nT
      {
        { \cs_if_exist_p:N \sa@orig@tikzpicture }
        { \cs_if_exist_p:N \sa@math }
        { ! \legacy_if_p:n { sa@math } }
      }
      { \sa@math }
  }
\AtBeginDocument { \__planar_standalone_math: }

% ---------------------------------------------------------------------------
% User interface
% ---------------------------------------------------------------------------
\NewDocumentCommand \paset { m }
  { \keys_set:nn { planaralgebra } {#1} }

\NewDocumentCommand \PAlayer { O{} m m }
  { \__planar_layer_cmd:nnn {#1} {#2} {#3} }

\cs_if_free:NT \PA
  {
    \bool_set_true:N \l__planar_pa_defined_bool
    \NewDocumentCommand \PA { O{} m m }
      { \__planar_layer_cmd:nnn {#1} {#2} {#3} }
  }

\NewDocumentCommand \PAdefine { O{} m +m }
  {
    \group_begin:
      \keys_set:nn { planaralgebra } {#1}
      \bool_set_true:N \l__planar_capture_bool
      \tl_set:Ne \l__planar_gen_tl { \tl_to_str:n {#2} }
      \tl_trim_spaces:N \l__planar_gen_tl
      \hbox_set:Nn \l__planar_tmp_box {#3}
    \group_end:
  }

\NewDocumentCommand \PAgenerators { s O{} }
  {
    \group_begin:
      \keys_set:nn { planaralgebra } {#2}
      \tl_clear:N \l__planar_draw_tl
      \fp_zero:N \l__planar_off_fp
      \bool_set_true:N \l__planar_first_bool
      \IfBooleanT {#1}
        {
          \clist_set:Ne \l__planar_list_clist
            {
              \clist_map_function:NN \l__planar_list_clist
                \__planar_drop_id:n
            }
        }
      \clist_map_inline:Nn \l__planar_list_clist
        {
          \__planar_start:
          \__planar_add_layer:nn { } {##1}
          \bool_if:NF \l__planar_error_bool
            {
              \bool_if:NF \l__planar_first_bool { \__planar_separator: }
              \bool_set_false:N \l__planar_first_bool
              \bool_if:NTF \l__planar_names_bool
                {
                  \tl_set:Ne \l__planar_caption_tl
                    {
                      \exp_not:N \texttt
                        { \tl_to_str:n {##1} }
                    }
                  \regex_replace_all:nnN { \( ([0-9]+) ; ([0-9]+) \) }
                    { (\1,\2) } \l__planar_caption_tl
                }
                { \tl_clear:N \l__planar_caption_tl }
              \__planar_draw_word:
            }
        }
      \__planar_picture:
    \group_end:
  }

\cs_new:Npn \__planar_drop_id:n #1
  {
    \str_if_eq:eeF { \prop_item:Ne \c__planar_alias_prop { \tl_trim_spaces:n {#1} } }
      { id }
      { \exp_not:n { {#1} , } }
  }

\NewExpandableDocumentCommand \PAlastloops { }
  { \int_use:N \g__planar_loops_int }
\NewExpandableDocumentCommand \PAlastboxes { }
  { \int_use:N \g__planar_boxes_int }
\NewExpandableDocumentCommand \PAlastnormalform { }
  { \str_use:N \g__planar_nf_str }

