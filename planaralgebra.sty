% ---------------------------------------------------------------------------
% Reading layers:  \PA{2,2}{id, T(1,1)}
% ---------------------------------------------------------------------------
\cs_new_protected:Npn \__planar_start:
  {
    \seq_clear:N \l__planar_layers_seq
    \int_zero:N \l__planar_layer_int
    \int_zero:N \l__planar_prev_int
    \bool_set_false:N \l__planar_error_bool
  }

\cs_new_protected:Npn \__planar_add_layer:nn #1#2
  {
    \int_incr:N \l__planar_layer_int
    \seq_clear:N \l__planar_items_seq
    \int_zero:N \l__planar_a_int
    \int_zero:N \l__planar_b_int
    \int_zero:N \l__planar_unknown_int
    \bool_set_false:N \l__planar_item_error_bool
    \tl_set:Nn \l__planar_tmp_tl {#2}
    \regex_replace_all:NnN \c__planar_paren_regex { (\1;\2) } \l__planar_tmp_tl
    \clist_set:NV \l__planar_items_clist \l__planar_tmp_tl
    \clist_map_inline:Nn \l__planar_items_clist { \__planar_parse_item:n {##1} }
    \bool_set_false:N \l__planar_declared_bool
    \tl_if_blank:nF {#1}
      {
        \exp_args:NNe \regex_extract_once:NnNTF \c__planar_counts_regex
          { \tl_to_str:n {#1} } \l__planar_match_seq
          {
            \bool_set_true:N \l__planar_declared_bool
            \int_set:Nn \l__planar_m_int { \seq_item:Nn \l__planar_match_seq { 2 } }
            \int_set:Nn \l__planar_n_int { \seq_item:Nn \l__planar_match_seq { 3 } }
          }
          {
            \bool_set_true:N \l__planar_error_bool
            \bool_set_true:N \l__planar_item_error_bool
            \msg_error:nnne { planaralgebra } { bad-counts } {#1}
              { \int_use:N \l__planar_layer_int }
          }
      }
    \__planar_infer:
    \tl_clear:N \l__planar_layer_tl
    \seq_map_inline:Nn \l__planar_items_seq { \__planar_finalize:nnnn ##1 }
    \bool_lazy_and:nnT
      { \l__planar_declared_bool } { ! \l__planar_item_error_bool }
      {
        \bool_lazy_or:nnT
          { \int_compare_p:n { \l__planar_m_int != \l__planar_a_int } }
          { \int_compare_p:n { \l__planar_n_int != \l__planar_b_int } }
          {
            \bool_set_true:N \l__planar_error_bool
            \msg_error:nneeee { planaralgebra } { arity-mismatch }
              { \int_use:N \l__planar_layer_int } { \tl_to_str:n {#1} }
              { \int_use:N \l__planar_a_int } { \int_use:N \l__planar_b_int }
          }
      }
    \bool_lazy_and:nnT
      { \int_compare_p:nNn \l__planar_layer_int > 1 }
      { ! \l__planar_item_error_bool }
      {
        \int_compare:nNnF \l__planar_prev_int = \l__planar_a_int
          {
            \bool_set_true:N \l__planar_error_bool
            \msg_error:nneeee { planaralgebra } { seam-mismatch }
              { \int_eval:n { \l__planar_layer_int - 1 } }
              { \int_use:N \l__planar_prev_int }
              { \int_use:N \l__planar_layer_int }
              { \int_use:N \l__planar_a_int }
          }
      }
    \int_set_eq:NN \l__planar_prev_int \l__planar_b_int
    \seq_put_right:NV \l__planar_layers_seq \l__planar_layer_tl
  }

\cs_new_protected:Npn \__planar_parse_item:n #1
  {
    \exp_args:NNe \regex_extract_once:NnNTF \c__planar_name_regex
      { \tl_to_str:n {#1} } \l__planar_match_seq
      {
        \tl_set:Ne \l__planar_name_tl { \seq_item:Nn \l__planar_match_seq { 2 } }
        \prop_get:NVNTF \c__planar_alias_prop \l__planar_name_tl
          \l__planar_canon_tl
          {
            \tl_set:Ne \l__planar_count_tl { \seq_item:Nn \l__planar_match_seq { 3 } }
            \tl_if_empty:NT \l__planar_count_tl
              { \tl_set:Nn \l__planar_count_tl { 1 } }
            \prg_replicate:nn { \l__planar_count_tl }
              {
                \seq_put_right:Ne \l__planar_items_seq
                  {
                    { \l__planar_canon_tl }
                    { \prop_item:NV \c__planar_gin_prop \l__planar_canon_tl }
                    { \prop_item:NV \c__planar_gout_prop \l__planar_canon_tl }
                    { }
                  }
              }
            \int_add:Nn \l__planar_a_int
              {
                \l__planar_count_tl *
                \prop_item:NV \c__planar_gin_prop \l__planar_canon_tl
              }
            \int_add:Nn \l__planar_b_int
              {
                \l__planar_count_tl *
                \prop_item:NV \c__planar_gout_prop \l__planar_canon_tl
              }
          }
          { \__planar_parse_box:n {#1} }
      }
      { \__planar_parse_box:n {#1} }
  }

% An input disc: `label(a,b)' (the comma has become `;' by now) or `label'.
\cs_new_protected:Npn \__planar_parse_box:n #1
  {
    \tl_set:Nn \l__planar_label_tl {#1}
    \regex_extract_once:NnNTF \c__planar_tail_regex {#1} \l__planar_match_seq
      {
        \regex_replace_once:NnN \c__planar_tail_regex { } \l__planar_label_tl
        \tl_trim_spaces:N \l__planar_label_tl
        \tl_set:Ne \l__planar_ta_tl { \seq_item:Nn \l__planar_match_seq { 2 } }
        \tl_set:Ne \l__planar_tb_tl { \seq_item:Nn \l__planar_match_seq { 3 } }
        \tl_set:Ne \l__planar_count_tl { \seq_item:Nn \l__planar_match_seq { 4 } }
        \tl_if_empty:NT \l__planar_count_tl
          { \tl_set:Nn \l__planar_count_tl { 1 } }
        \prg_replicate:nn { \l__planar_count_tl }
          {
            \seq_put_right:Ne \l__planar_items_seq
              {
                { box } { \int_eval:n { \l__planar_ta_tl } }
                { \int_eval:n { \l__planar_tb_tl } }
                { \exp_not:V \l__planar_label_tl }
              }
          }
        \int_add:Nn \l__planar_a_int { \l__planar_count_tl * \l__planar_ta_tl }
        \int_add:Nn \l__planar_b_int { \l__planar_count_tl * \l__planar_tb_tl }
      }
      {
        \tl_trim_spaces:N \l__planar_label_tl
        \int_incr:N \l__planar_unknown_int
        \seq_put_right:Ne \l__planar_items_seq
          { { box } { ? } { ? } { \exp_not:V \l__planar_label_tl } }
      }
  }

% A single disc without counts takes what the declared counts leave over.
\cs_new_protected:Npn \__planar_infer:
  {
    \int_compare:nNnT \l__planar_unknown_int > 0
      {
        \bool_lazy_all:nTF
          {
            { \int_compare_p:nNn \l__planar_unknown_int = 1 }
            { \l__planar_declared_bool }
            { \int_compare_p:nNn \l__planar_m_int > { \l__planar_a_int - 1 } }
            { \int_compare_p:nNn \l__planar_n_int > { \l__planar_b_int - 1 } }
          }
          {
            \tl_set:Ne \l__planar_ta_tl
              { \int_eval:n { \l__planar_m_int - \l__planar_a_int } }
            \tl_set:Ne \l__planar_tb_tl
              { \int_eval:n { \l__planar_n_int - \l__planar_b_int } }
            \int_set_eq:NN \l__planar_a_int \l__planar_m_int
            \int_set_eq:NN \l__planar_b_int \l__planar_n_int
          }
          {
            \bool_set_true:N \l__planar_error_bool
            \bool_set_true:N \l__planar_item_error_bool
            \seq_map_inline:Nn \l__planar_items_seq
              { \__planar_unknown_error:nnnn ##1 }
          }
      }
  }
\cs_new_protected:Npn \__planar_unknown_error:nnnn #1#2#3#4
  {
    \str_if_eq:nnT {#2} { ? }
      {
        \msg_error:nnee { planaralgebra } { box-arity } { \tl_to_str:n {#4} }
          { \int_use:N \l__planar_layer_int }
      }
  }
