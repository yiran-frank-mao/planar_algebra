% ---------------------------------------------------------------------------
% Variants and messages
% ---------------------------------------------------------------------------
\cs_generate_variant:Nn \prop_put:Nnn { Nee , Nen , Nne , NnV , NeV , NVV , cnV , cVn , cne , cVV }
\cs_generate_variant:Nn \prop_item:Nn { Ne , NV }
\cs_generate_variant:Nn \prop_get:NnN { Ne , NV }
\prg_generate_conditional_variant:Nnn \prop_get:NnN { Ne , NV } { T , F , TF }
\prg_generate_conditional_variant:Nnn \prop_if_in:Nn { Ne , NV } { T , F , TF }
\cs_generate_variant:Nn \prop_remove:Nn { ce }
\cs_generate_variant:Nn \seq_put_right:Nn { Ne }
\cs_generate_variant:Nn \clist_put_right:Nn { Ne }
\cs_generate_variant:Nn \clist_set:Nn { Ne , NV }
\cs_generate_variant:Nn \str_case:nnF { e }
\cs_generate_variant:Nn \msg_error:nnnn { nnVe , nnne , nnee }
\cs_generate_variant:Nn \msg_warning:nnn { nne }
\cs_generate_variant:Nn \msg_error:nnnnnn { nneeee }
\cs_generate_variant:Nn \msg_error:nnnnn { nneee }

\regex_const:Nn \c__planar_name_regex
  { \A \s* ([A-Za-z]+) \s* (?: \^ \s* \{? \s* ([0-9]+) \s* \}? )? \s* \Z }
\regex_const:Nn \c__planar_counts_regex
  { \A \s* ([0-9]+) \s* [,;/] \s* ([0-9]+) \s* \Z }
\regex_const:Nn \c__planar_paren_regex
  { \( \s* ([0-9]+) \s* [,;/] \s* ([0-9]+) \s* \) }
\regex_const:Nn \c__planar_tail_regex
  { \s* \( ([0-9]+) ; ([0-9]+) \) \s* (?: \^ \s* \{? \s* ([0-9]+) \s* \}? )? \s* \Z }

\msg_new:nnn { planaralgebra } { box-arity }
  {
    Cannot~tell~how~many~strands~the~input~disc~`#1'~in~layer~#2~has.~
    Write~it~as~`#1(a,b)'~(a~strands~on~the~input~side,~b~on~the~
    output~side),~or~make~it~the~only~disc~of~a~layer~whose~counts~
    are~given.~(The~generators~are~id,~ev~and~coev.)
  }
\msg_new:nnn { planaralgebra } { bad-counts }
  {
    The~first~argument~of~layer~#2~must~be~`m,n'~(numbers~of~input~and~
    output~strands)~or~empty,~not~`#1'.
  }
\msg_new:nnn { planaralgebra } { arity-mismatch }
  {
    Layer~#1~is~declared~as~`#2',~but~its~generators~have~
    #3~input~and~#4~output~strands.
  }
\msg_new:nnn { planaralgebra } { seam-mismatch }
  {
    Cannot~compose:~layer~#1~ends~with~#2~strands~but~layer~#3~starts~
    with~#4.
  }
\msg_new:nnn { planaralgebra } { undefined-tangle }
  { No~tangle~called~`#1'~has~been~defined~with~\iow_char:N\\PAdefine. }
\msg_new:nnn { planaralgebra } { insert-mismatch }
  {
    Cannot~insert~`#1'~into~input~disc~#2:~the~disc~has~#3~strands,~
    the~tangle~#4.
  }
\msg_new:nnn { planaralgebra } { no-shading }
  {
    A~disc~of~this~tangle~has~an~odd~number~of~strands,~so~the~regions~
    cannot~be~shaded~in~a~checkerboard~fashion.~The~tangle~is~drawn~
    without~shading.
  }
\msg_new:nnn { planaralgebra } { max-states }
  {
    The~normal~form~was~chosen~among~the~first~#1~arrangements~of~the~
    input~discs~only,~so~isotopic~tangles~may~get~different~normal~
    forms.~Raise~the~key~`max~states'~to~search~further.
  }
\msg_new:nnn { planaralgebra } { standalone-formula }
  {
    A~diagram~is~used~in~a~formula~that~the~`standalone'~class~does~not~
    turn~into~a~page:~with~its~`tikz'~option~only~TikZ~pictures,~
    \iow_char:N\\[...\iow_char:N\\]~and~\iow_char:N\\(...\iow_char:N\\)~
    become~(cropped)~pages.~Write~the~formula~with~
    \iow_char:N\\[...\iow_char:N\\]~or~\iow_char:N\\(...\iow_char:N\\),~
    or~use~\iow_char:N\\documentclass[varwidth]{standalone}~instead.
  }

% ---------------------------------------------------------------------------
% Generators
%
% An item of a layer is stored as {type}{a}{b}{label}: a strands on the input
% side (the top in vertical diagrams), b on the output side.  The types are
% id (1,1), ev (2,0: a cup), coev (0,2: a cap) and box (an input disc).
% ---------------------------------------------------------------------------
\prop_const_from_keyval:Nn \c__planar_alias_prop
  {
    id = id , line = id , strand = id ,
    ev = ev , cup = ev , pair = ev ,
    coev = coev , cap = coev , copair = coev ,
  }
\prop_const_from_keyval:Nn \c__planar_gin_prop { id = 1 , ev = 2 , coev = 0 }
\prop_const_from_keyval:Nn \c__planar_gout_prop { id = 1 , ev = 0 , coev = 2 }
\tl_const:Nn \c__planar_id_tl { { {id} {1} {1} {} } }

\cs_new:Npn \__planar_type:n #1 { \use_i:nnnn #1 }
\cs_new:Npn \__planar_in:n #1 { \use_ii:nnnn #1 }
\cs_new:Npn \__planar_out:n #1 { \use_iii:nnnn #1 }
\cs_new:Npn \__planar_in_plus:n #1 { + \use_ii:nnnn #1 }
\cs_new:Npn \__planar_out_plus:n #1 { + \use_iii:nnnn #1 }
\cs_new:Npn \__planar_layer_in:n #1
  { \int_eval:n { 0 \tl_map_function:nN {#1} \__planar_in_plus:n } }
\cs_new:Npn \__planar_layer_out:n #1
  { \int_eval:n { 0 \tl_map_function:nN {#1} \__planar_out_plus:n } }
\cs_generate_variant:Nn \__planar_layer_in:n { V , e }
\cs_generate_variant:Nn \__planar_layer_out:n { V , e }

